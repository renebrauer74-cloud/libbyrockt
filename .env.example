APP_NAME="Libby Rockt!"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://libbyrockt.test
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=libbyrockt
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
# Minuten ohne Klick, bis der Admin-Login abläuft (8 Stunden – lange Formulare gehen nicht verloren)
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@libbyrockt.de"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Libby Rockt! (config/libby.php) ---------------------------------------
# Absender für Antworten aus dem Posteingang und Kontaktadresse auf der Website
LIBBY_EMAIL=info@libbyrockt.de
LIBBY_PHONE=
LIBBY_VAT_ID=
# Allgemeiner Ticketshop (leer: der Tickets-Button führt ins Programm)
LIBBY_TICKETS_URL=
LIBBY_INSTAGRAM_URL=
LIBBY_FACEBOOK_URL=

# Uploads (Spatie Media Library): lokal public/uploads, auf Laravel Cloud den Bucket-Disk eintragen
MEDIA_DISK=uploads
# Anhänge aus dem Kontaktformular – nicht öffentlich
MEDIA_PRIVATE_DISK=local
